{
  "name": "ecsc-center-angular",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "ng": "ng",
    "center:new": "node scripts/create-center.mjs",
    "center:delete": "node scripts/delete-center.mjs",
    "dev": "turbo dev",
    "start": "npm run dev:ecsc",
    "build": "turbo build --concurrency=2",
    "typecheck": "turbo typecheck && tsc -p tsconfig.tests.json --noEmit",
    "lint": "node scripts/check-boundaries.mjs && eslint apps packages tests",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write apps packages docs tests scripts",
    "dev:ecsc": "npm run dev --workspace=ecsc",
    "build:ecsc": "turbo build --filter=ecsc",
    "dev:m3": "npm run dev --workspace=m3",
    "build:m3": "turbo build --filter=m3",
    "dev:jus": "npm run dev --workspace=jus",
    "build:jus": "turbo build --filter=jus",
    "preview:ecsc": "node scripts/serve.mjs ecsc",
    "preview:m3": "node scripts/serve.mjs m3",
    "preview:jus": "node scripts/serve.mjs jus",
    "dev:test-center": "npm run dev --workspace=test-center",
    "build:test-center": "turbo build --filter=test-center",
    "preview:test-center": "node scripts/serve.mjs test-center"
  },
  "dependencies": {
    "@angular/cdk": "22.2.3",
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "@fontsource/alexandria": "5.3.0",
    "@ng-icons/core": "36.1.0",
    "@ng-icons/phosphor-icons": "36.1.0",
    "@spartan-ng/brain": "1.8.0",
    "@tanstack/angular-table": "9.3.1",
    "echarts": "6.1.0",
    "exceljs": "4.4.0",
    "ngx-echarts": "22.0.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.6.0",
    "@angular/build": "22.2.3",
    "@angular/cli": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.19.1",
    "angular-eslint": "22.6.0",
    "eslint": "^10.0.0",
    "ng-packagr": "22.2.4",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.9",
    "tailwindcss": "4.3.3",
    "turbo": "^2.11.5",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  },
  "type": "module"
}
