{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["libs/ui/**"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@workspace/domain#build": {
      "outputs": ["../../dist/domain/**"],
      "dependsOn": ["^build"]
    },
    "@workspace/data-access#build": {
      "outputs": ["../../dist/data-access/**"],
      "dependsOn": ["^build"]
    },
    "@workspace/ui#build": {
      "outputs": ["../../dist/ui/**"],
      "dependsOn": ["^build"]
    },
    "@workspace/core#build": {
      "outputs": ["../../dist/core/**"],
      "dependsOn": ["^build"]
    },
    "ecsc#build": {
      "outputs": ["../../dist/apps/ecsc/**"],
      "dependsOn": ["^build"]
    },
    "m3#build": {
      "outputs": ["../../dist/apps/m3/**"],
      "dependsOn": ["^build"]
    },
    "jus#build": {
      "outputs": ["../../dist/apps/jus/**"],
      "dependsOn": ["^build"]
    },
    "test-center#build": {
      "outputs": ["../../dist/apps/test-center/**"],
      "dependsOn": ["^build"]
    },
    "layal-center#build": {
      "outputs": ["../../dist/apps/layal-center/**"],
      "dependsOn": ["^build"]
    },
    "m5#build": {
      "outputs": ["../../dist/apps/m5/**"],
      "dependsOn": ["^build"]
    },
    "@spartan-ng/helm#build": {
      "outputs": ["../../dist/helm/**"],
      "dependsOn": ["^build"]
    },
    "gov-center#build": {
      "outputs": ["../../dist/apps/gov-center/**"],
      "dependsOn": ["^build"]
    }
  }
}
